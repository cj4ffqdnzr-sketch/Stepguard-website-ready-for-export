<style id="sg-landing-tokens">
  :root{
    --bg: #ffffff;
    --surface: #ffffff;
    --surface-2: #f6f6f4;
    --line: #e6e6e3;
    --line-strong: #cfcfca;
    --text: #15202e;
    --muted: #677687;
    --dim: #9aa6b2;
    --steel: #3b4654;
    --accent: #e0521f;
    --accent-2: #cf4a1c;
    --maxw: 1180px;
    --pad: clamp(20px, 4vw, 56px);
    --display: "Space Grotesk", ui-sans-serif, system-ui;
    --body: "Manrope", ui-sans-serif, system-ui;
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }
  #sg-landing{ background: var(--bg); color: var(--text); font-family: var(--body); -webkit-font-smoothing: antialiased; }
  #sg-landing *{ box-sizing: border-box; }
  #sg-landing a{ color: inherit; text-decoration: none; }
  #sg-landing a:hover{ color: var(--accent-2); }
  #sg-landing img{ max-width:100%; display:block; }
  #sg-landing .wrap{ max-width: var(--maxw); margin: 0 auto; padding: 0 var(--pad); position: relative; z-index: 1; }

  #sg-landing .bg-grid{
    position:absolute; inset:0; pointer-events:none; z-index:0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center top, rgba(0,0,0,1), rgba(0,0,0,.35) 55%, transparent 85%);
    opacity: .5;
  }

  /* ---------- Nav ---------- */
  #sg-landing nav.top{
    position: relative; z-index: 2;
    border-bottom: 1px solid var(--line);
  }
  #sg-landing .nav-inner{
    max-width: var(--maxw); margin: 0 auto; padding: 18px var(--pad);
    display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap: wrap;
  }
  #sg-landing .brand{ display:flex; align-items:center; gap:10px; }
  #sg-landing .brand-mark{ width:30px; height:30px; }
  #sg-landing .brand-mark svg{ width:100%; height:100%; display:block; }
  #sg-landing .brand-name{ font-family: var(--display); font-weight:600; font-size:17px; letter-spacing:-.02em; color:#8c949e; }
  #sg-landing .brand-name b{ color: var(--accent); }
  #sg-landing .nav-links{ display:flex; gap:26px; align-items:center; }
  #sg-landing .nav-links a{ font-family: var(--display); font-size:14px; font-weight:500; color:var(--steel); }
  @media(max-width:680px){ #sg-landing .nav-links{ display:none; } }

  /* ---------- Hero ---------- */
  #sg-landing .hero{ position:relative; padding: 88px 0 56px; }
  #sg-landing .hero-grid{ display:grid; grid-template-columns: 1.05fr .95fr; gap:48px; align-items:center; }
  @media(max-width:980px){ #sg-landing .hero-grid{ grid-template-columns:1fr; gap:32px; } }
  #sg-landing .eyebrow{
    font-family: var(--mono); font-size:12px; letter-spacing:.2em; text-transform:uppercase;
    color: var(--accent-2);
  }
  #sg-landing h1.title{
    font-family: var(--display); font-weight:600;
    font-size: clamp(36px, 5vw, 58px); letter-spacing:-.03em; line-height:1.06;
    margin: 18px 0 20px; max-width: 760px; text-wrap: balance;
  }
  #sg-landing h1.title em{ font-style:normal; color: var(--accent-2); }
  #sg-landing .lede{ font-size: clamp(16px, 1.4vw, 18px); color: var(--steel); line-height:1.65; max-width: 640px; }
  #sg-landing .hero-ctas{ display:flex; gap:14px; margin-top:32px; flex-wrap: wrap; }
  #sg-landing .btn{
    font-family: var(--display); font-weight:600; font-size:14px;
    padding: 13px 24px; border-radius: 10px; display:inline-flex; align-items:center; gap:8px;
    transition: transform .15s, background .15s, border-color .15s;
  }
  #sg-landing .btn.primary{ background: var(--accent); color:#fff; }
  #sg-landing .btn.primary:hover{ background: var(--accent-2); color:#fff; transform: translateY(-1px); }
  #sg-landing .brand-name{ color: var(--word-grey, #8c949e); }
  #sg-landing .btn.ghost{ border:1px solid var(--line-strong); color: var(--text); }
  #sg-landing .btn.ghost:hover{ border-color: var(--accent); color: var(--accent-2); transform: translateY(-1px); }

  /* ---------- Hero visual: escalator scan scene ---------- */
  #sg-landing .hero-stage{
    position: relative; aspect-ratio: 1 / 1.05;
    border: 1px solid var(--line-strong);
    background: radial-gradient(60% 60% at 50% 40%, rgba(224,82,31,.10), transparent 70%), linear-gradient(180deg, #f6f6f4, #ffffff 80%);
    border-radius: 18px; overflow: hidden;
  }
  #sg-landing .hero-stage::before{
    content:""; position:absolute; inset:0;
    background-image: linear-gradient(rgba(0,0,0,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at 50% 50%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, #000, transparent 75%);
  }
  #sg-landing .hero-stage .label{ position:absolute; top:18px; left:18px; font-family:var(--mono); font-size:10px; letter-spacing:.2em; color:var(--accent-2); text-transform:uppercase; display:flex; align-items:center; gap:8px; }
  #sg-landing .hero-stage .label::before{ content:""; width:6px; height:6px; border-radius:50%; background:var(--accent-2); box-shadow:0 0 8px var(--accent-2); }
  #sg-landing .hero-stage .label-r{ position:absolute; top:18px; right:18px; font-family:var(--mono); font-size:10px; letter-spacing:.2em; color:var(--muted); text-transform:uppercase; }
  #sg-landing .stage-svg{ position:absolute; inset:0; width:100%; height:100%; }
  #sg-landing .hud{ position:absolute; bottom:18px; left:18px; right:18px; background:rgba(8,14,22,.75); border:1px solid var(--line); backdrop-filter:blur(8px); border-radius:12px; padding:14px 16px; display:grid; grid-template-columns:1fr auto; gap:12px; align-items:center; }
  #sg-landing .hud-title{ font-family:var(--mono); font-size:10px; letter-spacing:.18em; color:#9fb0c2; text-transform:uppercase; }
  #sg-landing .hud-status{ font-family:var(--display); font-weight:600; font-size:15px; margin-top:4px; color:#fff; }
  #sg-landing .hud-status .dot{ display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:8px; background:#1b8f4a; box-shadow:0 0 10px #1b8f4a; animation: sg-blink 1.4s infinite; vertical-align:middle; transition:background .4s, box-shadow .4s; }
  #sg-landing .hud[data-level="2"] .dot{ background:#F5C24D; box-shadow:0 0 10px #F5C24D; }
  #sg-landing .hud[data-level="3"] .dot{ background:#d63f2b; box-shadow:0 0 12px #d63f2b; }
  #sg-landing .hud[data-level="4"] .dot{ background:#e0521f; box-shadow:0 0 10px rgba(224,82,31,.6); }
  @keyframes sg-blink{ 50%{ opacity:.35 } }
  #sg-landing .levels{ display:flex; gap:6px; }
  #sg-landing .levels .lv{ width:26px; height:26px; border-radius:6px; border:1px solid rgba(255,255,255,.25); display:grid; place-items:center; font-family:var(--mono); font-size:11px; color:#9fb0c2; }
  #sg-landing .levels .lv.on{ color:#0a0a0a; }
  #sg-landing .levels .lv.l1.on{ background:#1b8f4a; border-color:#1b8f4a; }
  #sg-landing .levels .lv.l2.on{ background:#F5C24D; border-color:#F5C24D; }
  #sg-landing .levels .lv.l3.on{ background:#d63f2b; border-color:#d63f2b; color:#fff; }
  #sg-landing .levels .lv.l4.on{ background:#e0521f; border-color:#e0521f; color:#fff; }
  #sg-landing .scene-cards{ position:absolute; top:50px; left:18px; width:min(62%, 292px); z-index:3; pointer-events:none; }
  #sg-landing .scene-card{ position:absolute; top:0; left:0; width:100%; background:rgba(8,14,22,.86); backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,.14); border-radius:10px; padding:12px 14px 13px; opacity:0; transform:translateY(-8px); transition:opacity .45s, transform .45s; }
  #sg-landing .scene-card.show{ opacity:1; transform:none; }
  #sg-landing .scene-card.is-warn{ border-color:rgba(245,194,77,.45); }
  #sg-landing .scene-card.is-hot{ border-color:rgba(214,63,43,.55); }
  #sg-landing .scene-card.is-ok{ border-color:rgba(27,143,74,.55); }
  #sg-landing .sc-eyebrow{ font-family:var(--mono); font-size:9px; letter-spacing:.16em; text-transform:uppercase; color:rgba(255,255,255,.85); display:flex; align-items:center; gap:7px; }
  #sg-landing .sc-eyebrow::before{ content:""; flex:0 0 auto; width:7px; height:7px; border-radius:50%; background:#F5C24D; box-shadow:0 0 8px #F5C24D; animation: sg-blink 1.4s infinite; }
  #sg-landing .scene-card.is-hot .sc-eyebrow::before{ background:#d63f2b; box-shadow:0 0 8px #d63f2b; }
  #sg-landing .scene-card.is-ok .sc-eyebrow::before{ background:#1b8f4a; box-shadow:0 0 8px #1b8f4a; animation:none; }
  #sg-landing .sc-title{ font-family:var(--display); font-weight:650; font-size:14.5px; line-height:1.35; color:#fff; margin-top:7px; }
  #sg-landing .sc-meta{ font-family:var(--mono); font-size:10px; letter-spacing:.04em; color:rgba(255,255,255,.8); margin-top:5px; }
  #sg-landing .wear-ring{ animation: sg-wearPulse 1.6s ease-in-out infinite; }
  @keyframes sg-wearPulse{ 0%,100%{ stroke-opacity:.95 } 50%{ stroke-opacity:.2 } }
  #sg-landing .scan-tick{ animation: sg-tickFade .9s ease forwards; }
  @keyframes sg-tickFade{ 0%{opacity:0} 15%{opacity:1} 100%{opacity:0} }

  /* ---------- Trust strip ---------- */
  #sg-landing .trust{ padding: 0 0 40px; }
  #sg-landing .trust-inner{ display:flex; align-items:center; gap:28px; flex-wrap:wrap; padding-top: 28px; border-top:1px solid var(--line); }
  #sg-landing .trust-label{ font-family: var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color: var(--dim); display:flex; align-items:center; gap:10px; }
  #sg-landing .trust-label::before{ content:""; width:18px; height:1px; background:var(--accent); }
  #sg-landing .trust-logos{ display:flex; align-items:center; gap:28px; flex-wrap:wrap; }
  #sg-landing .trust-logos img{ height:26px; width:auto; max-width:120px; object-fit:contain; opacity:.85; }
  #sg-landing .trust-name{ font-family: var(--display); font-weight:600; font-size:15px; letter-spacing:-.01em; color: var(--steel); }

  /* ---------- Card grid ---------- */
  #sg-landing .grid-section{ padding: 24px 0 96px; }
  #sg-landing .grid-head{ margin-bottom: 32px; }
  #sg-landing .grid-head .kicker{ font-family: var(--mono); font-size:11px; letter-spacing:.18em; text-transform:uppercase; color: var(--dim); }
  #sg-landing .grid-head h2{ font-family: var(--display); font-weight:600; font-size: clamp(22px,2.4vw,28px); letter-spacing:-.02em; margin: 10px 0 0; }
  #sg-landing .cards{ display:grid; grid-template-columns: repeat(4, 1fr); gap:16px; }
  @media(max-width:980px){ #sg-landing .cards{ grid-template-columns: repeat(2,1fr); } }
  @media(max-width:560px){ #sg-landing .cards{ grid-template-columns: 1fr; } }
  #sg-landing .card{
    display:flex; flex-direction:column; gap:14px;
    padding: 28px 24px; border:1px solid var(--line); border-radius:16px;
    background: linear-gradient(180deg, rgba(255,255,255,.02), transparent);
    opacity:0; transform: translateY(14px); transition: opacity .5s, transform .5s, border-color .2s, background .2s, box-shadow .25s;
  }
  #sg-landing .card.in{ opacity:1; transform:none; }
  #sg-landing .card:hover{ border-color: var(--accent); background: rgba(224,82,31,.06); transform: translateY(-4px); box-shadow: 0 16px 32px -20px rgba(21,32,46,.35); }
  #sg-landing .card .icon{ width:38px; height:38px; display:grid; place-items:center; color: var(--accent-2); transition: color .2s, transform .25s; }
  #sg-landing .card .icon svg{ width:100%; height:100%; display:block; }
  #sg-landing .card:hover .icon{ color: var(--accent); transform: scale(1.08); }
  #sg-landing .card h3{ font-family: var(--display); font-weight:600; font-size:19px; letter-spacing:-.01em; margin:0; }
  #sg-landing .card p{ font-size:14px; color: var(--muted); line-height:1.6; margin:0; flex:1; }
  #sg-landing .card .go{ font-family: var(--mono); font-size:12px; letter-spacing:.08em; color: var(--steel); display:inline-flex; align-items:center; gap:6px; }
  #sg-landing .card .go svg{ width:12px; height:12px; transition: transform .2s; }
  #sg-landing .card:hover .go{ color: var(--accent-2); }
  #sg-landing .card:hover .go svg{ transform: translateX(3px); }

  /* ---------- Footer ---------- */
  #sg-landing footer{ border-top:1px solid var(--line); padding: 32px 0; }
  #sg-landing .foot-inner{ display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  #sg-landing .foot-inner .brand-name{ font-size:14px; }
  #sg-landing .foot-links{ display:flex; gap:20px; flex-wrap:wrap; }
  #sg-landing .foot-links a{ font-family: var(--mono); font-size:12px; letter-spacing:.06em; color: var(--muted); }

  #sg-landing .reveal{ opacity:0; transform: translateY(14px); transition: opacity .5s, transform .5s; }
  #sg-landing .reveal.in{ opacity:1; transform:none; }
</style>

