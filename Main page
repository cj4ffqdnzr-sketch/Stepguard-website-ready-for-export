<script>
  (function(){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: .1, rootMargin: '0px 0px -60px 0px' });
    document.querySelectorAll('#sg-landing .reveal').forEach(function(el){ io.observe(el); });
  })();

  (function sgHeroMovie(){
    var SVGNS = 'http://www.w3.org/2000/svg';
    var stepsG = document.getElementById('sgSteps');
    var beam = document.getElementById('sgLaserBeam');
    var hud = document.getElementById('sgHud');
    var title = document.getElementById('sgHudTitle');
    var status = document.getElementById('sgHudStatus');
    var levels = document.getElementById('sgHudLevels');
    var ticksG = document.getElementById('sgScanTicks');
    var cards = { 2: document.getElementById('sgCardDetect'), 3: document.getElementById('sgCardAlert'), 4: document.getElementById('sgCardPlan') };
    if (!stepsG || !beam || !hud || !title || !status || !levels) return;
    var beamCore = beam.nextElementSibling;
    var dot = document.getElementById('sgLaserDot');
    var dotCore = dot ? dot.nextElementSibling : null;
    var STR = {
      1: ['Riggel-integriteitsscan · Niveau 1', 'Niveau 1, Slijtage binnen marge · alle riggels gemeten'],
      2: ['Riggel-integriteitsscan · Niveau 2', 'Niveau 2, Riggel-slijtage gedetecteerd · trede 09'],
      3: ['Riggel-integriteitsscan · Niveau 3', 'Niveau 3, Alert verzonden · uitval verwacht ±3 weken'],
      4: ['Geplande fix · Werkorder WO-2231', 'Onderhoud ingepland · trede 09 vervangen vóór storing']
    };
    var SLOTS = 13, PX = 38, PY = -34, BASE_X = 10, BASE_Y = 380, W = 46, H = 12;
    var GX = 40, GY = 80, PITCH_MS = 1800, OX = 88, OY = 470, WORN_NO = 9;
    function mk(tag, attrs){ var n = document.createElementNS(SVGNS, tag); for (var k in attrs) n.setAttribute(k, attrs[k]); return n; }
    var slots = [];
    for (var j = 0; j < SLOTS; j++){
      var g = mk('g', {});
      var plate = mk('path', { d: 'M 0 0 L ' + W + ' 0 L ' + W + ' ' + H + ' L 0 ' + H + ' Z', fill: 'url(#sgStepGrad)', stroke: 'url(#sgStepEdge)', 'stroke-width': '.8' });
      var riser = mk('path', { d: 'M ' + W + ' 0 L ' + (W + PX * 0.18) + ' -12', stroke: 'rgba(123,215,255,.18)', 'stroke-width': '1' });
      var label = mk('text', { x: 2, y: -2, 'font-family': 'JetBrains Mono', 'font-size': '6', fill: 'rgba(123,215,255,.4)', 'letter-spacing': '0.5' });
      var wear = mk('rect', { x: 14, y: 2, width: 18, height: 7, rx: 1, fill: '#F5C24D', opacity: 0 });
      var ring = mk('rect', { x: 10, y: -2, width: 26, height: 15, rx: 3, fill: 'none', stroke: '#F5C24D', 'stroke-width': '1', opacity: 0, 'class': 'wear-ring' });
      g.appendChild(plate); g.appendChild(riser); g.appendChild(label); g.appendChild(wear); g.appendChild(ring);
      stepsG.appendChild(g);
      slots.push({ g: g, label: label, wear: wear, ring: ring, shownNo: null });
    }
    function wrapNo(n){ return ((n - 1) % 14 + 14) % 14 + 1; }
    var ids = [];
    for (j = 0; j < SLOTS; j++) ids.push({ no: wrapNo(11 - j) });
    var TOTAL = 14;
    var WEAR_SEED = [52, 44, 57, 16, 49, 41, 61, 38, 88, 46, 54, 18, 43, 50];
    var wearByNo = {};
    for (var n = 1; n <= TOTAL; n++) wearByNo[n] = WEAR_SEED[n - 1];
    var criticalNo = WORN_NO;
    function pad2(n){ return String(n).padStart(2, '0'); }
    function sevColor(w){ return w >= 85 ? '#d63f2b' : w >= 30 ? '#F5C24D' : '#1b8f4a'; }
    var level = 1;
    function setLevel(lv){
      level = lv;
      hud.setAttribute('data-level', String(lv));
      title.textContent = STR[lv][0];
      status.textContent = STR[lv][1];
      levels.querySelectorAll('.lv').forEach(function(el){ el.classList.toggle('on', +el.dataset.lv <= lv); });
      for (var k in cards) if (cards[k]) cards[k].classList.toggle('show', +k === lv);
      fixStepNos();
    }
    function fixStepNos(){
      var els = [title, status];
      for (var k in cards) if (cards[k]) els.push(cards[k].querySelector('.sc-title'));
      els.forEach(function(el){ if (!el) return; el.textContent = el.textContent.replace(/\btrede(\s+)\d{2}\b/gi, function(m, sp){ return 'trede' + sp + pad2(criticalNo); }); });
    }
    var flashUntil = 0, flashColor = '#1b8f4a';
    function tickFlash(color, txt, x, y){
      flashUntil = performance.now() + 500; flashColor = color;
      if (!ticksG) return;
      var t = mk('text', { x: x + 10, y: y - 10, fill: color, 'class': 'scan-tick', 'font-family': 'JetBrains Mono', 'font-size': '8' });
      t.textContent = txt; ticksG.appendChild(t);
      setTimeout(function(){ t.remove(); }, 950);
      while (ticksG.childNodes.length > 4) ticksG.firstChild.remove();
    }
    var crossN = 0, detectAt = -1;
    function onCross(){
      crossN++;
      for (var n2 = 1; n2 <= TOTAL; n2++) wearByNo[n2] = Math.min(99, wearByNo[n2] + 0.06);
      var id = ids[2];
      wearByNo[id.no] = Math.min(99, wearByNo[id.no] + 0.5);
      var w = Math.round(wearByNo[id.no]);
      var sx = GX + BASE_X + 1.5 * PX + 23, sy = GY + BASE_Y + 1.5 * PY + 4;
      if (id.no === criticalNo && level === 1){ detectAt = crossN; setLevel(2); tickFlash('#F5C24D', '! ' + w + '%', sx, sy); return; }
      if (level === 2 && crossN === detectAt + 2) setLevel(3);
      else if (level === 3 && crossN === detectAt + 5) setLevel(4);
      else if (level === 4 && crossN === detectAt + 8){
        wearByNo[criticalNo] = 4;
        var next = 1;
        for (var n3 = 1; n3 <= TOTAL; n3++) if (wearByNo[n3] > wearByNo[next]) next = n3;
        criticalNo = next; wearByNo[criticalNo] = Math.max(wearByNo[criticalNo], 87);
        setLevel(1);
      }
      tickFlash(sevColor(w), w + '%', sx, sy);
    }
    var WEAR_STYLES = { 1: { fill: '#F5C24D', op: .22, ring: null, lab: null }, 2: { fill: '#F5C24D', op: .85, ring: '#F5C24D', lab: '#FFC74D' }, 3: { fill: '#d63f2b', op: .9, ring: '#d63f2b', lab: '#d63f2b' }, 4: { fill: '#1b8f4a', op: .6, ring: '#1b8f4a', lab: '#3ddc84' } };
    function render(p, now){
      for (var j2 = 0; j2 < SLOTS; j2++){
        var s = j2 - 1 + p, sl = slots[j2], id2 = ids[j2];
        sl.g.setAttribute('transform', 'translate(' + (BASE_X + s * PX).toFixed(2) + ', ' + (BASE_Y + s * PY).toFixed(2) + ')');
        if (sl.shownNo !== id2.no){ sl.shownNo = id2.no; sl.label.textContent = String(id2.no).padStart(2, '0'); }
        var w2 = wearByNo[id2.no] || 0;
        var isCrit = id2.no === criticalNo;
        if (isCrit && level > 1){
          var st = WEAR_STYLES[level] || WEAR_STYLES[1];
          sl.wear.setAttribute('x', '12'); sl.wear.setAttribute('width', '22');
          sl.wear.setAttribute('fill', st.fill); sl.wear.setAttribute('opacity', st.op);
          if (st.ring){ sl.ring.setAttribute('stroke', st.ring); sl.ring.setAttribute('opacity', '1'); } else sl.ring.setAttribute('opacity', '0');
          sl.label.setAttribute('fill', st.lab || 'rgba(123,215,255,.4)');
        } else {
          var wpx = 6 + (w2 / 100) * 20;
          sl.wear.setAttribute('x', (23 - wpx / 2).toFixed(1)); sl.wear.setAttribute('width', wpx.toFixed(1));
          sl.wear.setAttribute('fill', sevColor(w2)); sl.wear.setAttribute('opacity', (0.14 + (w2 / 100) * 0.55).toFixed(2));
          sl.ring.setAttribute('opacity', '0'); sl.label.setAttribute('fill', w2 >= 85 ? '#d63f2b' : 'rgba(123,215,255,.4)');
        }
      }
      var stp = p < 0.5 ? 1 + p : p;
      var sweep = 14 * Math.sin(now / 260);
      var tx = GX + BASE_X + stp * PX + 23 + sweep, ty = GY + BASE_Y + stp * PY + 4;
      var d = 'M ' + OX + ' ' + OY + ' L ' + tx.toFixed(1) + ' ' + ty.toFixed(1);
      beam.setAttribute('d', d); if (beamCore) beamCore.setAttribute('d', d);
      var hot = now < flashUntil;
      if (dot){ dot.setAttribute('cx', tx.toFixed(1)); dot.setAttribute('cy', ty.toFixed(1)); dot.setAttribute('r', hot ? '5' : '3'); dot.setAttribute('fill', hot ? flashColor : '#d63f2b'); }
      if (dotCore){ dotCore.setAttribute('cx', tx.toFixed(1)); dotCore.setAttribute('cy', ty.toFixed(1)); }
    }
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setLevel(1);
    if (reduced){ for (j = 0; j < SLOTS; j++) ids[j] = { no: wrapNo(WORN_NO + (6 - j)) }; setLevel(2); render(0.3, 0); return; }
    var p2 = 0, last = null;
    function frame(ts){
      if (last == null) last = ts;
      var dt = Math.min(ts - last, 64); last = ts;
      var prev = p2; p2 += dt / PITCH_MS;
      if (prev < 0.5 && p2 >= 0.5) onCross();
      if (p2 >= 1){ p2 -= 1; ids.pop(); var newNo = wrapNo(ids[0].no + 1); ids.unshift({ no: newNo }); }
      render(p2, ts);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>
